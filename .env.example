# Local values only. Replace passwords before deploying. Do not commit .env.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace_with_your_unique_password
POSTGRES_DB=nexora
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgresql+psycopg://nexora:replace_with_your_unique_password@localhost:55432/nexora
REDIS_URL=redis://localhost:56379/0
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
API_INTERNAL_URL=http://localhost:8000
# Phase 4 compatible API root, e.g. https://provider.example/v1; no automatic fallback.
# Leave blank to save/extract documents without enabling AI. Keys remain server-side.
AI_PROVIDER=compatible
AI_REQUEST_TIMEOUT=30
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# Optional OCR service: POST application/pdf -> {"pages":[{"number":1,"text":"..."}]}
OCR_URL=
OCR_API_KEY=

# Local alternative: AI_PROVIDER=ollama, AI_BASE_URL=http://host.docker.internal:11434
# AI_CHAT_MODEL=qwen3:1.7b, AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Local small-model settings: AI_REQUEST_TIMEOUT=120, DOCUMENT_CHUNK_SIZE=800, DOCUMENT_CHUNK_OVERLAP=100
